# ==============================================================================
# OpenStockAPI Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Your API Key (Format: 'free_xxx', 'pro_xxx', or 'premium_xxx')
# Register for a key at: https://openstockapi.com/register
OPENSTOCKAPI_KEY=your_api_key_here

# Optional: Override the backend Core Engine Gateway URL
# Default is http://localhost:8001 for local development
# OPENSTOCKAPI_BACKEND_URL=http://localhost:8001
